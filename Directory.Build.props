<Project>

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup>
    <Product>WeArchive</Product>
    <Company>WeArchive</Company>
    <Authors>WeArchive</Authors>
    <VersionPrefix>0.5.1</VersionPrefix>
    <Copyright>WeArchive contributors</Copyright>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/lybym/WeArchive</RepositoryUrl>
  </PropertyGroup>

  <!-- Windows-only product: win-x64 only for the MVP. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
