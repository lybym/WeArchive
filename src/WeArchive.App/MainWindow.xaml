<Window x:Class="WeArchive.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WeArchive.App.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="WeArchive — 微信聊天记录本地归档与导出"
        Height="820" Width="1080"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#FFF4F6F9">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel Margin="14">

        <!-- Global status bar -->
        <Border DockPanel.Dock="Bottom" Padding="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="#FF5A6472" />
                <TextBlock Grid.Column="1" Foreground="#FF98A2B3" Margin="12,0,0,0">
                    <Run Text="v" /><Run Text="{Binding ApplicationVersion, Mode=OneWay}" />
                </TextBlock>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ===================== Environment ===================== -->
                <GroupBox Header="环境状态" Padding="12" Background="White">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="微信状态：" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceStatus}" TextWrapping="Wrap" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="账号：" Style="{StaticResource FieldLabel}" Margin="0,6,8,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,4,0,0"
                                      ItemsSource="{Binding Accounts}"
                                      DisplayMemberPath="SourceProfileId"
                                      SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="数据源状态：" Style="{StaticResource FieldLabel}" Margin="0,6,8,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DataSourceStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="档案：" Style="{StaticResource FieldLabel}" Margin="0,6,8,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ArchiveStatus}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="重新检测" Command="{Binding RefreshCommand}" Padding="14,5" />
                            <Button Content="检查更新" Command="{Binding CheckUpdatesCommand}" Padding="14,5" Margin="8,0,0,0" />
                            <TextBlock Text="环境检测与导出均在本地完成，读取微信数据时全程只读。" 
                                       Foreground="#FF98A2B3" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ===================== Conversations ===================== -->
                <GroupBox Header="会话" Padding="12" Margin="0,12,0,0" Background="White">
                    <Grid Height="320">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="搜索：" VerticalAlignment="Center" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="260" Padding="4,3" VerticalAlignment="Center"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="类型：" VerticalAlignment="Center" Margin="18,0,8,0" Style="{StaticResource FieldLabel}" />
                            <RadioButton Content="全部" GroupName="kind" VerticalAlignment="Center" Margin="0,0,10,0"
                                         IsChecked="{Binding FilterAll, Mode=TwoWay}" />
                            <RadioButton Content="好友" GroupName="kind" VerticalAlignment="Center" Margin="0,0,10,0"
                                         IsChecked="{Binding FilterDirect, Mode=TwoWay}" />
                            <RadioButton Content="群聊" GroupName="kind" VerticalAlignment="Center"
                                         IsChecked="{Binding FilterGroup, Mode=TwoWay}" />
                            <TextBlock VerticalAlignment="Center" Margin="18,0,0,0" Foreground="#FF98A2B3">
                                <Run Text="共 " /><Run Text="{Binding ConversationCount, Mode=OneWay}" /><Run Text=" 个会话" />
                            </TextBlock>
                        </StackPanel>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}"
                                 SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ConversationItemViewModel}">
                                    <Grid Margin="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Subtitle}" Foreground="#FF98A2B3" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding LastMessageLabel}"
                                                   Foreground="#FF98A2B3" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </GroupBox>

                <!-- ===================== Selection & export ===================== -->
                <GroupBox Header="选中会话与导出" Padding="12" Margin="0,12,0,0" Background="White">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionHeader}" Text="选中会话" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding SelectedConversation.Title, TargetNullValue=（未选择）}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ConversationDetail}" TextWrapping="Wrap" Margin="0,6,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="导出目录" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Padding="4,4" Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1" Content="浏览…" Command="{Binding BrowseCommand}" Padding="14,4" Margin="8,0,0,0" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="开始导出" Command="{Binding ExportCommand}" Padding="26,7"
                                    FontWeight="SemiBold" Background="#FF1F6FEB" Foreground="White" BorderThickness="0" />
                            <Button Content="取消" Command="{Binding CancelCommand}" Padding="18,7" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ===================== Progress ===================== -->
                <GroupBox Header="Progress" Padding="12" Margin="0,12,0,0" Background="White">
                    <StackPanel>
                        <!-- ProgressBar.Value/Maximum default to TwoWay; the view model
                             exposes them read-only, so the mode is explicit. -->
                        <ProgressBar Height="18" Minimum="0"
                                     Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                     Value="{Binding ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ProgressStage}" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressCounters}" Foreground="#FF5A6472" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ===================== Result ===================== -->
                <GroupBox Header="结果" Padding="12" Margin="0,12,0,12" Background="White">
                    <StackPanel>
                        <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PartialWarning}" Foreground="#FFB54708" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding HasPartialWarning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ResultPath}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#FF1F6FEB" />
                        <Button Content="打开导出目录" Command="{Binding OpenResultFolderCommand}" HorizontalAlignment="Left"
                                Padding="14,4" Margin="0,8,0,0"
                                Visibility="{Binding HasResultPath, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB42318" TextWrapping="Wrap" Margin="0,8,0,0" />

                        <TextBlock Style="{StaticResource SectionHeader}" Text="诊断" />
                        <ItemsControl ItemsSource="{Binding Diagnostics}" MaxHeight="160">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Foreground="#FF5A6472" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
