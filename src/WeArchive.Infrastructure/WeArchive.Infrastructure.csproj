<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WeArchive.Infrastructure</RootNamespace>
    <AssemblyName>WeArchive.Infrastructure</AssemblyName>
    <Platforms>AnyCPU</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="YamlDotNet" />
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeArchive.Core\WeArchive.Core.csproj" />
  </ItemGroup>

  <!--
    The compatibility/crypto internals are exercised directly by the test project so that
    page decryption, WAL recovery and the WeChat payload parsers can be tested without a
    running WeChat client.
  -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>WeArchive.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
