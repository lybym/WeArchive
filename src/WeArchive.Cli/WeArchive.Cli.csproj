<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WeArchive.Cli is the primary product surface: a gh-style command-line application.

    It is a thin transport/presentation boundary over application services and must not
    contain WeChat schema logic, archive semantics or export business rules.
    docs/ARCHITECTURE.md section 3.1, docs/adr/0006-cli-first-product-surface.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WeArchive.Cli</RootNamespace>
    <!--
      The shipped executable is WeArchive.exe, so scripts and agents invoke `wearchive`
      from PATH exactly as docs/CLI.md documents. The assembly was named WeArchive.Cli only
      while the historical WPF project (WeArchive.App) also produced an assembly named
      WeArchive; that collision is gone now that the WPF surface is retired (Issue #9).
    -->
    <AssemblyName>WeArchive</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeArchive.Core\WeArchive.Core.csproj" />
    <ProjectReference Include="..\WeArchive.Infrastructure\WeArchive.Infrastructure.csproj" />
  </ItemGroup>

</Project>
